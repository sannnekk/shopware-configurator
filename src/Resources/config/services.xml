<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="HMnet\Configurator\Core\Content\Configurator\ConfiguratorOptionPossibilityEntity">
            <tag name="shopware.entity"/>
        </service>

        <service id="HMnet\Configurator\Core\Content\Configurator\ConfiguratorOptionEntity">
            <tag name="shopware.entity"/>
        </service>

        <service id="HMnet\Configurator\Core\Content\Configurator\ConfiguratorFieldEntity">
            <tag name="shopware.entity"/>
        </service>

        <service id="HMnet\Configurator\Core\Content\Product\ConfiguratorProductExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="HMnet\Configurator\Core\Content\Promotion\PromotionDiscountSettingEntity">
            <tag name="shopware.entity"/>
        </service>

        <service id="HMnet\Configurator\Core\Content\Promotion\PromotionDiscountExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="HMnet\Configurator\Core\Content\Configurator\PriceTierCollectionSerializer">
            <argument type="service" id="validator"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="HMnet\Configurator\Storefront\Page\Product\ProductConfiguratorSubscriber">
            <argument type="service" id="hmnet_configurator_field.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="plugin.repository" />
            <tag name="kernel.event_subscriber"/>
        </service>

        <!--
            Must run after the PromotionProcessor (4900): promotions then only see the base product price,
            option and setup/film costs are added to the product price afterwards.
        -->
        <service id="HMnet\Configurator\Core\Checkout\Cart\ConfiguratorCartProcessor">
            <tag name="shopware.cart.processor" priority="0" />
            <argument type="service" id="HMnet\Configurator\Service\ConfiguratorLineItemHandler" />
            <argument type="service" id="HMnet\Configurator\Service\SetupFilmLineItemHandler" />
            <argument type="service" id="Psr\Log\LoggerInterface" />
            <argument type="service" id="Shopware\Core\Checkout\Cart\Tax\TaxCalculator" />
            <argument type="service" id="HMnet\Configurator\Service\ConfiguratorPriceService" />
        </service>

        <!-- Must run after the ConfiguratorCartProcessor (0) and before the delivery processors (-5000) -->
        <service id="HMnet\Configurator\Core\Checkout\Cart\ConfiguratorPromotionProcessor">
            <tag name="shopware.cart.processor" priority="-100" />
            <tag name="kernel.reset" method="reset" />
            <argument type="service" id="Doctrine\DBAL\Connection" />
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\PercentagePriceCalculator" />
        </service>

        <service id="HMnet\Configurator\Service\ConfiguratorLineItemHandler">
            <tag name="shopware.cart.line_item.factory" />
        </service>

        <service id="HMnet\Configurator\Service\SetupFilmLineItemHandler">
            <tag name="shopware.cart.line_item.factory" />
            <argument type="service" id="Shopware\Core\Checkout\Cart\Tax\TaxCalculator" />
        </service>

        <service id="HMnet\Configurator\Core\Checkout\Cart\ConfiguratorCartCollector">
            <tag name="shopware.cart.collector" />
            <argument type="service" id="hmnet_configurator_field.repository"/>
            <argument type="service" id="Psr\Log\LoggerInterface" />
        </service>

        <service id="HMnet\Configurator\Core\Checkout\Cart\ConfiguratorLineItemSubscriber">
            <tag name="kernel.event_subscriber" />
        </service>

        <service id="HMnet\Configurator\Service\ConfiguratorPriceService">
            <argument type="service" id="product.repository" />
            <argument type="service" id="hmnet_configurator_field.repository" />
        </service>

        <service id="HMnet\Configurator\Storefront\Controller\ConfiguratorPdfController" public="true">
            <argument type="service" id="product.repository" />
            <argument type="service" id="hmnet_configurator_field.repository" />
            <argument type="service" id="media.repository" />
            <argument type="service" id="language.repository" />
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="Shopware\Core\Checkout\Document\Service\PdfRenderer" />
            <argument type="service" id="HMnet\Configurator\Service\ConfiguratorPriceService" />
            <argument type="service" id="Doctrine\DBAL\Connection" />
            <argument type="service" id="Shopware\Storefront\Theme\ThemeConfigValueAccessor" />
            <argument>%kernel.project_dir%</argument>
            <tag name="controller.service_arguments" />
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

        <service id="HMnet\Configurator\Storefront\Controller\ConfiguratorCalculateController" public="true">
            <argument type="service" id="HMnet\Configurator\Service\ConfiguratorPriceService" />
            <tag name="controller.service_arguments" />
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

    </services>
</container>