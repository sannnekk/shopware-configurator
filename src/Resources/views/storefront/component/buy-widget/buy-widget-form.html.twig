{% sw_extends '@Storefront/storefront/component/buy-widget/buy-widget-form.html.twig' %}

{% block buy_widget_buy_container %}
	<div data-hmnet-configurator-hint class="hmnet-product-configurator__hint alert alert-warning" style="display: none;" aria-hidden="true" role="alert"></div>

	{{ parent() }}

	<input
		data-hmnet-configurator-payload
		type="hidden"
		name="lineItems[{{ product.id }}][payload]"
		value="[]"
	/>
{% endblock %}

{% block buy_widget_buy_button_container %}
	{{ parent() }}

	<div class="hmnet-product-actions mt-2 d-flex gap-2 flex-wrap">
		<div class="hmnet-form-trigger text-center">
			<button class="hmnet-action-button btn btn-secondary"
				type="button"
				data-hmnet-configurator-pdf-download="quote">
				{{ 'HMnetConfigurator.BuyWidget.DownloadPdf'|trans }}
			</button>
		</div>
		{% if 'hmnet_form' is defined %}
			{{ hmnet_form('contactForm-freePattern', 'trigger_only') }}
			{{ hmnet_form('concactForm-product', 'trigger_only') }}
		{% endif %}
	</div>
{% endblock %}

{# Render modals outside the buy widget form #}
{% block buy_widget_buy_form_inner %}
	{{ parent() }}

	{% if 'hmnet_form' is defined %}
		{{ hmnet_form('contactForm-freePattern', 'modal_only') }}
		{{ hmnet_form('concactForm-product', 'modal_only') }}
	{% endif %}
{% endblock %}
