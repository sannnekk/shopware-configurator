{% sw_extends '@Storefront/storefront/component/line-item/type/product.html.twig' %}

{#
    Products configured with the HMnet configurator carry their chosen options as child line
    items. Their prices are already folded into the parent price by the cart processor, so the
    children must not be rendered as separate line items. Instead the whole configuration is
    shown as one breakdown panel below the regular product row - identical on the cart page,
    the off-canvas cart, the confirm page and in the order history.

    Filtering runs on `children.elements` so that it works for both `LineItemCollection` (cart)
    and `OrderLineItemCollection` (order), which do not share a common filter method. Using the
    plain array also keeps `filter` returning an array instead of a single-use generator.
#}

{% set hmnetOptionType = constant('HMnet\\Configurator\\Service\\ConfiguratorLineItemHandler::TYPE') %}
{% set hmnetSurchargeType = constant('HMnet\\Configurator\\Service\\SetupFilmLineItemHandler::TYPE') %}

{% set hmnetChildren = lineItem.children ? lineItem.children.elements : [] %}
{% set hmnetOptions = hmnetChildren|filter(child => child.type == hmnetOptionType) %}
{% set hmnetSurcharges = hmnetChildren|filter(child => child.type == hmnetSurchargeType) %}
{% set hmnetIsConfigured = hmnetOptions|length > 0 %}

{% block component_line_item_type_product_inner %}
    {{ parent() }}

    {% if hmnetIsConfigured %}
        {% block hmnet_configurator_line_item_summary %}
            {% sw_include '@HMnetConfigurator/storefront/component/line-item/configurator/summary.html.twig' with {
                lineItem: lineItem,
                options: hmnetOptions,
                surcharges: hmnetSurcharges,
                displayMode: displayMode|default('default'),
                context: context
            } only %}
        {% endblock %}
    {% endif %}
{% endblock %}

{# The summary panel replaces the generic "this item contains" accordion. #}
{% block component_line_item_type_product_children %}
    {% if not hmnetIsConfigured %}
        {{ parent() }}
    {% endif %}
{% endblock %}
