{% if (children and children|length > 0) or (setupFilmChildren and setupFilmChildren|length > 0) %}
	<li class="line-item line-item-hmnet-configurator-title is-default hmnet-configurator-confirm-row hmnet-configurator-confirm-row--title">
		<div class="row line-item-row">
			<div class="line-item-info">
				<div class="line-item-details">
					<div class="line-item-details-container">
						<div class="line-item-product-number">
							{{ 'hmnet-configurator.cart.optionsTitle'|trans|sw_sanitize }}
						</div>
					</div>
				</div>
			</div>
			<div class="line-item-quantity"></div>
			{% if showTaxPrice %}
				<div class="line-item-tax-price"></div>
			{% else %}
				<div class="line-item-unit-price"></div>
			{% endif %}
			{% if showSubtotal %}
				<div class="line-item-total-price"></div>
			{% endif %}
		</div>
	</li>

	{% for child in children|default([]) %}
		{% set optionQuantity = child.quantity|default(1) %}
		{% set optionUnitPrice = child.price and child.price.unitPrice is defined ? child.price.unitPrice : (optionQuantity > 0 and child.price ? child.price.totalPrice / optionQuantity : null) %}
		{% set optionTotalPrice = child.price ? child.price.totalPrice : null %}
		<li class="line-item line-item-hmnet-configurator-option is-default hmnet-configurator-confirm-row">
			<div class="row line-item-row">
				<div class="line-item-info">
					<div class="line-item-details">
						<div class="line-item-details-container hmnet-configurator-confirm-row__name">
							{{ child.label|sw_sanitize }}
						</div>
					</div>
				</div>
				<div class="line-item-quantity hmnet-configurator-confirm-row__value">{{ optionQuantity }}</div>
				{% if showTaxPrice %}
					<div class="line-item-tax-price hmnet-configurator-confirm-row__value">{% if optionUnitPrice is not null %}{{ optionUnitPrice|currency(currencyIso) }}{% else %}-{% endif %}</div>
				{% else %}
					<div class="line-item-unit-price hmnet-configurator-confirm-row__value">{% if optionUnitPrice is not null %}{{ optionUnitPrice|currency(currencyIso) }}{% else %}-{% endif %}</div>
				{% endif %}
				{% if showSubtotal %}
					<div class="line-item-total-price hmnet-configurator-confirm-row__value">{% if optionTotalPrice is not null %}{{ optionTotalPrice|currency(currencyIso) }}{% else %}-{% endif %}</div>
				{% endif %}
			</div>
		</li>
	{% endfor %}

	{% for child in setupFilmChildren|default([]) %}
		{% set setupQuantity = child.quantity|default(1) %}
		{% set setupUnitPrice = child.price and child.price.unitPrice is defined ? child.price.unitPrice : (setupQuantity > 0 and child.price ? child.price.totalPrice / setupQuantity : null) %}
		{% set setupTotalPrice = child.price ? child.price.totalPrice : null %}
		<li class="line-item line-item-hmnet-configurator-option is-default hmnet-configurator-confirm-row hmnet-configurator-confirm-row--setup">
			<div class="row line-item-row">
				<div class="line-item-info">
					<div class="line-item-details">
						<div class="line-item-details-container hmnet-configurator-confirm-row__name">
							{{ child.label|sw_sanitize }}
						</div>
					</div>
				</div>
				<div class="line-item-quantity hmnet-configurator-confirm-row__value"></div>
				{% if showTaxPrice %}
					<div class="line-item-tax-price hmnet-configurator-confirm-row__value">{% if setupUnitPrice is not null %}{{ setupUnitPrice|currency(currencyIso) }}{% else %}-{% endif %}</div>
				{% else %}
					<div class="line-item-unit-price hmnet-configurator-confirm-row__value">{% if setupUnitPrice is not null %}{{ setupUnitPrice|currency(currencyIso) }}{% else %}-{% endif %}</div>
				{% endif %}
				{% if showSubtotal %}
					<div class="line-item-total-price hmnet-configurator-confirm-row__value">{% if setupTotalPrice is not null %}{{ setupTotalPrice|currency(currencyIso) }}{% else %}-{% endif %}</div>
				{% endif %}
			</div>
		</li>

		{% for option in child.payload.positions|default([]) %}
			{% set nestedQuantity = option.quantity|default(1) %}
			{% set nestedTotalPrice = option.price|default(null) %}
			{% set nestedUnitPrice = nestedTotalPrice is not null and nestedQuantity > 0 ? nestedTotalPrice / nestedQuantity : nestedTotalPrice %}
			<li class="line-item line-item-hmnet-configurator-option is-default hmnet-configurator-confirm-row hmnet-configurator-confirm-row--nested">
				<div class="row line-item-row">
					<div class="line-item-info">
						<div class="line-item-details">
							<div class="line-item-details-container hmnet-configurator-confirm-row__name">
								{{ option.label|sw_sanitize }}
							</div>
						</div>
					</div>
					<div class="line-item-quantity hmnet-configurator-confirm-row__value">{{ nestedQuantity }}</div>
					{% if showTaxPrice %}
						<div class="line-item-tax-price hmnet-configurator-confirm-row__value">{% if nestedUnitPrice is not null %}{{ nestedUnitPrice|currency(currencyIso) }}{% else %}-{% endif %}</div>
					{% else %}
						<div class="line-item-unit-price hmnet-configurator-confirm-row__value">{% if nestedUnitPrice is not null %}{{ nestedUnitPrice|currency(currencyIso) }}{% else %}-{% endif %}</div>
					{% endif %}
					{% if showSubtotal %}
						<div class="line-item-total-price hmnet-configurator-confirm-row__value">{% if nestedTotalPrice is not null %}{{ nestedTotalPrice|currency(currencyIso) }}{% else %}-{% endif %}</div>
					{% endif %}
				</div>
			</li>
		{% endfor %}
	{% endfor %}
{% endif %}